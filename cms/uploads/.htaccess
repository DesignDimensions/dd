# Uploaded files are served as files, never run as code.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(?i:svg)$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
  </FilesMatch>
</IfModule>
